# Copy to .env (git-ignored) and fill in. Loaded by run_ui.py and forwarded to
# the Showman render worker when it is spawned.

# Authoring model for visual lessons. Without a key the worker falls back to
# Showman's offline template author, which produces generic children's lessons
# unrelated to a circuit brief; the command center refuses to author in that
# state rather than serve one.
OPENROUTER_API_KEY=

# Authoring model. This workspace uses free models only: the manager refuses to
# start a worker on anything without the `:free` suffix, because OpenRouter bills
# every other model per token and Showman's own default is one of them.
#
# Measured 2026-09-01 on the brief "Show current flowing through an RC circuit,
# then connect it to the charging equation":
#
#   minimax/minimax-m3:free                authored  46 s (2 attempts), full render 348 s
#   nvidia/nemotron-3-super-120b-a12b:free authored  49 s
#   minimax/minimax-m2.7:free              authored  58 s
#   inclusionai/ling-3.0-flash-fin:free    authored 114 s
#   dots-studio/dots-3-note-preview:free   authored 127 s
#   cohere/north-mini-code:free            failed, unparseable JSON from the author
#   z-ai/glm-5.2:free                      429 from the provider, never reached the model
#   google/gemma-4-31b-it:free             429 from the provider, never reached the model
#
# Free tiers are rate limited, so a brief that fails will often author on a retry.
# The worker reads this at spawn, so changing it needs a worker restart.
OPENROUTER_MODEL=minimax/minimax-m3:free
