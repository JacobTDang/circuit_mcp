# Copy to .env (git-ignored) and fill in. Loaded by run_ui.py and forwarded to
# the Showman render worker when it is spawned.

# Authoring model for visual lessons. Without a key the worker falls back to
# Showman's offline template author, which produces generic children's lessons
# unrelated to a circuit brief; the command center refuses to author in that
# state rather than serve one.
OPENROUTER_API_KEY=

# Model choice decides whether circuit briefs author at all. Measured on the
# brief "Show current flowing through an RC circuit, then connect it to the
# charging equation":
#
#   google/gemini-2.5-flash               ok,     1 attempt,   ~12 s
#   openai/gpt-oss-120b                   failed, 3 attempts, ~116 s (Showman's default)
#   nvidia/nemotron-3-ultra-550b-a55b:free failed, malformed JSON, frequently overloaded
#
# The worker reads this at spawn, so changing it needs a worker restart.
OPENROUTER_MODEL=google/gemini-2.5-flash
